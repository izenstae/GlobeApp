# Copy to .env and fill in. Never commit .env.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

DATABASE_URL=postgresql+asyncpg://globe:globe@localhost:5432/globe
REDIS_URL=redis://localhost:6379/0

# Optional overrides (defaults shown)
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=["http://localhost:5173"]
# SCHEDULER_ENABLED=true

# UCDP GED baseline (no key needed)
# UCDP_API_VERSION=25.1
# UCDP_WINDOW_DAYS=365
# UCDP_INTERVAL=604800
